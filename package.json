{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "GPL-3.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "lint:check": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "export:openapi": "ts-node scripts/export-openapi.ts",
    "validate:openapi": "swagger-cli validate openapi.json",
    "test:integration": "jest --config ./test/jest-e2e.json --testPathPatterns=prescriptions.e2e-spec.ts",
    "postman:generate": "node scripts/postman/generate.cjs",
    "api:refresh": "pnpm export:openapi && pnpm validate:openapi && pnpm postman:generate",
    "test:openapi-contract": "jest --testPathPatterns=openapi-contract",
    "postman:test:local": "mkdir -p reports/postman && newman run postman/prescription-api.postman_collection.json -e postman/prescription-api.local.postman_environment.json --env-var seedPassword=$SEED_DEFAULT_PASSWORD --reporters cli,junit --reporter-junit-export reports/postman/newman-local.xml",
    "postman:test:ci": "mkdir -p reports/postman && newman run postman/prescription-api.postman_collection.json -e postman/prescription-api.ci.postman_environment.json --env-var seedPassword=$SEED_DEFAULT_PASSWORD --reporters cli,junit --reporter-junit-export reports/postman/newman-ci.xml"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.2",
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "nanoid": "^3.3.12",
    "nodemailer": "^8.0.5",
    "passport-jwt": "^4.0.1",
    "puppeteer": "^24.43.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.0.4",
    "newman": "^6.2.2",
    "openapi-to-postmanv2": "^6.0.1",
    "prettier": "^3.4.2",
    "prisma": "^6.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      ".module.ts",
      "main.ts",
      ".entity.ts",
      ".dto.ts",
      ".decorator.ts",
      ".guard.ts",
      ".filter.ts",
      ".controller.ts",
      ".interface.ts",
      "env.validation.ts",
      "permissions.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@11.1.1"
}
