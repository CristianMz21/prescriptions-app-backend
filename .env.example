# PostgreSQL connection string. Defaults to the docker-compose Postgres
# defined at the monorepo root (`docker compose up -d postgres` exposes
# 5433 → container 5432). Override for a managed Postgres in production.
DATABASE_URL="postgresql://user:Password123!@localhost:5433/prescriptions_db?schema=public"

# JWT Access Token (used for short-lived access tokens)
JWT_ACCESS_SECRET="change-me-access-secret"

# JWT Refresh Token (used for refresh token rotation)
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Access token TTL — examples: "900s", "15m", "1h"
JWT_ACCESS_TTL="900s"

# Refresh token TTL — examples: "7d", "14d", "604800s"
JWT_REFRESH_TTL="7d"

# Frontend URL for PDF QR code links and callback redirects
# Required if APP_ORIGIN is not set
FRONTEND_URL="http://localhost:3001"

# App/CORS origin for cross-origin requests
# Required if FRONTEND_URL is not set
# If both are set, APP_ORIGIN takes precedence for CORS
APP_ORIGIN="http://localhost:3001"

# Server port
PORT=3000

# Environment: development, production, or test
NODE_ENV="development"

# Password for seeded users (admin, doctors, patient)
# Both prisma/seed.ts and test/test-credentials.ts read this variable.
# If unset, falls back to '<DEV_SEED_PASSWORD>' and logins fail until configured.
SEED_DEFAULT_PASSWORD="Password123!"