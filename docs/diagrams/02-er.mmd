%%{init: {"theme": "base", "themeVariables": {"fontSize": "16px"}}}%%
erDiagram
    USER {
        string id PK
        string email UK
        string passwordHash
        enum role "ADMIN|DOCTOR|PATIENT"
        datetime createdAt
        datetime updatedAt
    }

    PRESCRIPTION {
        string id PK
        enum status "PENDING|CONSUMED"
        json items "[{name,dosage,instructions}]"
        string notes
        datetime createdAt
        datetime updatedAt
        datetime consumedAt
        string doctorId FK
        string patientId FK
    }

    USER ||--o{ PRESCRIPTION : "doctor"
    USER ||--o{ PRESCRIPTION : "patient"