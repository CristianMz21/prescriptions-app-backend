# Render production environment template (backend)
# Copy values into Render Dashboard -> Environment

NODE_ENV="production"
PORT=10000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="7d"

# Canonical frontend origin(s)
FRONTEND_URL="https://prescriptions-app-eight.vercel.app"
APP_ORIGIN="https://prescriptions-app-eight.vercel.app"

# Optional comma-separated extra explicit origins (no spaces required)
# Example for custom domain + staging domain:
# CORS_ADDITIONAL_ORIGINS="https://app.example.com,https://staging.example.com"
CORS_ADDITIONAL_ORIGINS=""

# Restrictive Vercel preview rule (required to allow preview deployments)
CORS_PREVIEW_PREFIX="https://prescriptions-"
CORS_PREVIEW_REQUIRED_SEGMENT="cristians-projects-04637ff3"
CORS_PREVIEW_SUFFIX=".vercel.app"

SEED_DEFAULT_PASSWORD="Password123!"
