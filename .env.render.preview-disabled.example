# Render template if you want ONLY fixed origins (preview URLs disabled)

NODE_ENV="production"
PORT=10000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="7d"

FRONTEND_URL="https://prescriptions-app-eight.vercel.app"
APP_ORIGIN="https://prescriptions-app-eight.vercel.app"
CORS_ADDITIONAL_ORIGINS=""

# Leave all preview vars unset to disable dynamic preview allowance
# CORS_PREVIEW_PREFIX=
# CORS_PREVIEW_REQUIRED_SEGMENT=
# CORS_PREVIEW_SUFFIX=

SEED_DEFAULT_PASSWORD="Password123!"
